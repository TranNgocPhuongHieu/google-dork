LOG_LEVEL=INFO
LOG_FORMAT=text

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_DONE_TOPIC=social.done
KAFKA_CONSUMER_GROUP_ID=google-dork-playwright-v1
JOB_HEARTBEAT_SECONDS=60

PROXY_CATALOG_FILE=../../proxy.md
PROXY_FAILURE_COOLDOWN_MS=300000
PROXY_BLOCKED_COOLDOWN_MS=1200000
PROXY_ROTATING_RESET_TIMEOUT_MS=15000
PROXY_ROTATING_RESET_WAIT_MS=5000

# Optional paid fallback. Without this key, captcha handling remains proxy-only.
CAPTCHA_API_KEY=
CAPTCHA_TIMEOUT_MS=120000
CAPTCHA_POLL_MS=5000

# Offline audio solver. Keep disabled until the candidate-image canary passes.
CAPTCHA_LOCAL_AUDIO_ENABLED=false
CAPTCHA_LOCAL_TIMEOUT_MS=60000
CAPTCHA_LOCAL_MAX_ATTEMPTS=2
# The image currently contains only the verified en-US model.
CAPTCHA_LOCAL_LANGUAGE=en-US
CAPTCHA_VOSK_MODEL_PATH=/opt/models/vosk
CAPTCHA_VOSK_LIBRARY_PATH=/opt/vosk/lib/libvosk.so
CAPTCHA_FFMPEG_PATH=/usr/bin/ffmpeg
CAPTCHA_WORKER_SHUTDOWN_MS=3000

BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_MS=45000
BROWSER_RESULT_WAIT_TIMEOUT_MS=15000
BROWSER_LOCALE=vi-VN

SEARCH_KEYWORD_IDS=
SEARCH_DATE_FROM=2026-06-24
SEARCH_DATE_TO=2026-06-28
SEARCH_TIME_FILTER=custom
SEARCH_SPLIT_DAYS=1
SEARCH_WORKERS=1
SEARCH_MAX_PAGES=9
SEARCH_TIER_A_MAX_PAGES=9
SEARCH_TIER_B_MAX_PAGES=6
SEARCH_TIER_C_MAX_PAGES=3
SEARCH_MAX_ATTEMPTS=3
SEARCH_QUERY_DELAY_MIN_MS=30000
SEARCH_QUERY_DELAY_MAX_MS=60000
SEARCH_PAGE_DELAY_MIN_MS=10000
SEARCH_PAGE_DELAY_MAX_MS=20000

DATABASE_URL=postgresql://admin:admin@localhost:5434/social_scraper
